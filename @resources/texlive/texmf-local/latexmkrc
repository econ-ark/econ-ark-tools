# -*- mode: shell-script; coding: utf-8 -*-
# Google 'latexmk' for explanation of this config file
# latexmk at unix command line will compile the paper
$do_cd = 1;
#$clean_ext = "nav out snm dvi idv tmp xref 4tc out aux log fls fdb_latexmk synctex.gz toc svg png 4ct ps out.ps mk4 lg cfg css html yml upa upb";
@generated_exts = (@generated_exts, 'blg','fdb_latexmk','fls', 'idv','md.tmp','mk4','lg','snm','synctex.gz', 'tex.cfg','nav','out','ps','ps_out','tex.mk4', 'tmp', 'upa','upb','toc','4ct');
$bibtex_use=2;
$pdf_mode = 1;
$rc_report = 1;
# No dates, file ID or build paths inside the PDF, so rebuilding unchanged sources gives the same bytes
# (Chris, 2026-11-25: a recompile must not make a git diff that only changes a date). pdflatex only.
$pre_tex_code = '\pdfinfoomitdate=1 \pdftrailerid{} \pdfsuppressptexinfo=-1 ';
$pdflatex="pdflatex -interaction=nonstopmode %O %P";
# Only $pdflatex has %P, so lualatex and xelatex never get those pdfTeX primitives.
# XeLaTeX: xdvipdfmx always writes the date and names font subsets at random, unless SOURCE_DATE_EPOCH
# is set (Chris, 2026-11-27: "set SOURCE_DATE_EPOCH in the shared latexmkrc"). A value already set is
# kept; otherwise 0. It is set for xdvipdfmx alone: in the TeX run it would also change printed dates
# to 1970 (LuaLaTeX's \today, datetime2's \today, \DTMnow and \DTMcurrenttime under pdfLaTeX).
$xdvipdfmx = 'env SOURCE_DATE_EPOCH=' . ($ENV{SOURCE_DATE_EPOCH} // '0') . ' xdvipdfmx -E -o %D %O %S';
@default_files = ('*.tex');
$aux_out_dir_report = 0;
$silent  = 1;
#warn "PATH = '$ENV{PATH}'\n";
