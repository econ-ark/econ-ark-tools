% variables:
%% principles:
%% - Levels (Lvl) are boldface italic
%% - Normalized (Nrm) are plain
%% - Aggregate variables are marked by Agg and are upper case
%% - Individual variables are marked by Ind and are lower case
%% - The combination of Ind and Agg is marked by All
%% - If the problem has only one shock, the Ind and Agg can be omitted

% Note: Level and normalized variables for all letters are defined explicitly above
% Only special cases and exceptions need manual definition below

%% Individual-level (idosyncratic) variables
\ARKcommand{\permShkInd}{\psi}     % (purely) permanent
\ARKcommand{\permShk}{\permShkInd} % unspecified (but only one) shock
\ARKcommand{\PermShk}{\PermShkAgg} % unspecified (but only one) shock
\ARKcommand{\tranShkInd}{\xi}      % (purely) transitory
\ARKcommand{\permShkIndMin}{\Min{\permShkInd}}
\ARKcommand{\permShkIndMax}{\Max{\permShkInd}}
% Capital Greek numbers print italic, by rule C (italic for a number, upright for a function):
% \varPhi, \varTheta, \varPsi, \varXi, \varOmega (owner ruling 2026-11-15; were upright).
\ARKcommand{\prstShkAgg}{\varPhi}     % persistent not permanent
% \prstShkInd, \prstShk and their Min/Max were \phi, which is the log equity premium (\eprem);
% used by no paper, they are retired (owner ruling 2026-10-22). A paper that needs a persistent shock proposes a symbol.
\ARKcommand{\tranShkMin}{\Min{\xi}}
\ARKcommand{\tranShkMax}{\Max{\xi}}

%% Transitory shock for employed individuals
\ARKcommand{\tranShkEmp}{\theta}     % ind
\ARKcommand{\TranShkEmp}{\TranShkAgg}  % alias: Theta is the aggregate of theta; \TranShkAgg is canonical (owner ruling 2026-10-22)
\ARKcommand{\tranShkEmpMin}{\Min{\tranShkEmp}}    
\ARKcommand{\tranShkEmpMax}{\Max{\tranShkEmp}}    
\ARKcommand{\IncUnemp}{\xi_{\mathrm{u}}}  % Income in unemployment: the transitory shock's value in the unemployment event
%  (owner, 2026-10-22: subscripts u and x; was \xi_{\mathrm{U}}, and before 2026-10-21 \mu, which the registry gives to \logmNrmEx)
\ARKcommand{\IncUnempNoBen}{\xi_{\mathrm{x}}}  % income once unemployment benefits have expired ("x for eXpired", owner 2026-10-22)
\ARKcommand{\IncUnempBen}{\IncUnemp}           % alias: income while unemployed and receiving benefits (HAFiscal's name)

%% Agg variables (also affect individuals)
\ARKcommand{\TranShkAgg}{\varTheta}   % the aggregate transitory shock, aggregate of \tranShkEmp (xi has no aggregate)
\ARKcommand{\PermShkAgg}{\varPsi}  % 

%% Shock std and var
\ARKcommand{\std}{\sigma}
\ARKcommand{\tranShkIndStd}{\std_{\tranShkInd}}     % 
\ARKcommand{\tranShkIndVar}{\std^{2}_{\tranShkInd}} % 
\ARKcommand{\TranShkAggStd}{\std_{\TranShkAgg}}     %
\ARKcommand{\TranShkAggVar}{\std^{2}_{\TranShkAgg}} %

%% Combo variables (combining Ind and Agg)
% Principle: "All" (Ind+Agg) uses \pmb for all such macros. \pmb is supported by MathJax and KaTeX.
\ARKcommand{\PermShkAll}{\pmb{\varPsi}}
\ARKcommand{\PermShkAllStd}{\std_{\PermShkAll}}
\ARKcommand{\PermShkAllVar}{\std^{2}_{\PermShkAll}}

\ARKcommand{\PermLvlAgg}{\boldsymbol{P}}      % 
\ARKcommand{\permLvlInd}{\boldsymbol{p}}      % 
\ARKcommand{\permLvl}{\permLvlInd}      % 
\ARKcommand{\PermLvl}{\PermLvlAgg}      % 
\ARKcommand{\PermLvlAll}{\pmb{P}}

\ARKcommand{\tranShkAll}{\tranShkInd} % the same shock as \tranShkInd, zero-income event included:
                                       % "identical, not distinct" (ruling 2026-10-21). Was \pmb{\xi}.
% \TranShkAll (was \pmb{\Xi}) retired (owner ruling 2026-10-22): \tranShkAll is \tranShkInd, xi has no aggregate, and Xi is population growth.
\ARKcommand{\tranShkAllStd}{\std_{\tranShkAll}}
\ARKcommand{\tranShkAllVar}{\std^{2}_{\tranShkAll}}

%% MPC min and max values
\ARKcommand{\MPCmin}{\Min{\MPC}}
\ARKcommand{\MPCmax}{\Max{\MPC}}
\ARKcommand{\MPCmaxmax}{\Max{\Max{\MPC}}}
\ARKcommand{\MPCmaxmin}{\Max{\Min{\MPC}}}
\ARKcommand{\MPCminmin}{\Min{\Min{\MPC}}}

%% Growth factors (owner rulings 2026-11-02, adopted in v9.0.0). Permanent-income growth is sans-serif, 𝖦 = 1 + 𝗀,
%% as 𝖱 = 1 + 𝗋; until v9.0.0 it was calligraphic, which passes to productivity growth (\PtyGroFac below). Aggregate
%% permanent growth (HARK's PermGroFacAgg) IS productivity growth, so \PermGroFacAgg is an alias (it was \mathscr{G}).
%% Wage growth, and permanent labor income growth in perfect-foresight models, stays roman G and g.
\ARKcommand{\PermGroFacAgg}{\PtyGroFac}   % alias
\ARKcommand{\permGroFacInd}{\mathit{G}}
\ARKcommand{\PermGroFac}{\mathsf{G}}
\ARKcommand{\PermGroFacRnd}{\Rnd{\PermGroFac}}       % normalization including shock
\ARKcommand{\PermGroFacAdj}{\Min{\PermGroFac}}
\ARKcommand{\PermGroFacuAdj}{\Min{\Min{\PermGroFac}}}
\ARKcommand{\PermGroRte}{\mathsf{g}}
\ARKcommand{\WGroFac}{\ensuremath{\mathrm{G}}}
\ARKcommand{\WGroRte}{\mathrm{g}}

%% Other factors and rates 
%%% probability of remaining \Alive is 1 - prob of dying
\ARKcommand{\Alive}{\mathcal{L}}
\ARKcommand{\diePrb}{\mathsf{d}} % Continuous time death rate (annual)
\ARKcommand{\DiePrb}{\mathsf{D}} % Discrete-time one-period death rate
\ARKcommand{\UpdatePrb}{\varPi}   % probability of updating expectations (sticky expectations; HARK-style name UpdatePrb; owner ruling 2026-11-16)

\ARKcommand{\DeprFac}{\daleth}
\ARKcommand{\deprRte}{\delta}  % 
\ARKcommand{\DiscFac}{\beta}
\ARKcommand{\DiscFacAlt}{\beth}
\ARKcommand{\DiscAlt}{\beth}
\ARKcommand{\DiscAltuAdj}{\Min{\Min{\beth}}}
\ARKcommand{\DiscFacRaw}{\beta}
% Survival: an unaccented beta or thorn excludes the survival probability; the RING includes it (owner ruling 2026-10-22):
% \mathring{\beta} = \beta\LivPrb, \mathring{\APFac} = (\Rfree\mathring{\beta})^{1/\CRRA}. The ring variants take HARK's suffix
% Eff, as in its DiscFacEff = DiscFac*LivPrb and in \RfreeEff; "Liv" is kept for HARK's GPFacLiv (owner, 2026-10-22).
% (\DiscFacLiv was \Min{\DiscFacRaw}, an underline, which also means a lower bound.)
\ARKcommand{\DiscFacEff}{\mathring{\DiscFacRaw}}
\ARKcommand{\DiscFacLiv}{\DiscFacEff}   % alias: the v5 name, which the BST paper writes
% The time preference rate, beta = 1/(1+vartheta) (owner ruling 2026-11-02). It was \nu, with the note that vartheta is too
% easily confused with theta (\tranShkEmp); the owner chose vartheta, the course's long-standing letter.
\ARKcommand{\DiscRte}{\vartheta}
\ARKcommand{\discRte}{\vartheta}

% The thorn glyphs, both plain. \APFac makes the factor bold, once: \textbf, a real bold face, as
% in the notation registry (owner, 2026-10-21: "a single \textbf not double"; this was
% \text{\pmb{\Thorn}} with a \Thorn that was itself \pmb, so the thorn was bolded twice).
% \thorn is the rates' small thorn. The glyphs are taken from T1 whatever the document's encoding
% (in OT1 \TH does not exist); the generated KaTeX map writes them as Þ and þ.
\ARKcommand{\Thorn}{\text{\fontencoding{T1}\selectfont\TH}}
\ARKcommand{\thorn}{\text{\fontencoding{T1}\selectfont\th}}
\ARKcommand{\APFac}{\textbf{\Thorn}} % Former \Pat
\ARKcommand{\APFacDefn}{\hyperlink{APFacDefn}{\textrm{APF}}}

% The patience factors are WRITTEN with a subscript, as the registry writes them: Þ_𝖦 and Þ_R,
% not the ratios Þ/𝖦 and Þ/R that define them (ruling 2026-10-21, to bring econark-shortcuts
% and the notation registry to one form).
\ARKcommand{\GPFac}{\GPFacRaw}
\ARKcommand{\GPFacRaw}{\APFac_{\PermGroFac}}
\ARKcommand{\GPFacMod}{\GPFacRaw\EPermShkInv}  % BST's product form (owner ruling 2026-10-22) (was \APFac_{\PermGroFacAdj})
\ARKcommand{\RPFac}{\APFac_{\Rfree}}
% Survival-inclusive (ring) patience factors, HARK's APFac, RPFac and GPFacRaw, which all include LivPrb. The
% unaccented \APFac, \RPFac, \GPFacRaw above exclude survival, so HARK's same-named variables are the Eff forms.
\ARKcommand{\APFacEff}{\mathring{\APFac}}            % (\Rfree \DiscFacEff)^{1/\CRRA}
\ARKcommand{\RPFacEff}{\APFacEff_{\Rfree}}
\ARKcommand{\GPFacEff}{\APFacEff_{\PermGroFac}}
\ARKcommand{\GPFacLiv}{\LivPrb\GPFacEff}     % mortality-adjusted, HARK's GPFacLiv: the GIC-Liv is \GPFacLiv < 1

\ARKcommand{\RPRte}{\text{\thorn}_{\rfree}}
\ARKcommand{\GPRte}{\text{\thorn}_{\PermGroRte}}
\ARKcommand{\APRte}{\text{\thorn}}

% The stochastic discount factor and its log take the eth, the thorn's sibling, with the factor/rate case convention
% (owner ruling 2026-11-02): Ð_{t,t+n} = β^n u'(c_{t+n})/u'(c_t), ð = log Ð. Bold, as the patience factors are. The
% glyphs come from T1 as the thorns' do; \eth is amssymb's own ð, so the log is \sdf. M stays market resources.
\ARKcommand{\SDF}{\textbf{\text{\fontencoding{T1}\selectfont\DH}}}
\ARKcommand{\sdf}{\text{\fontencoding{T1}\selectfont\dh}}

\ARKcommand{\EPermShkInv}{\Ex[\permShk^{-1}]}  % Formerly EpShkInv
% The growth- and utility-compensated permanent shocks are power means of psi (owner ruling 2026-10-22):
% the harmonic mean M_{-1}[psi] = (E[psi^{-1}])^{-1}, and M_{1-rho}[psi] = (E[psi^{1-rho}])^{1/(1-rho)}.
% (They were \underline{\psi}, which is also the minimum \permShkIndMin, and a double underline.)
\ARKcommand{\InvEPermShkInv}{{\PowMean_{-1}[\permShk]}}
\ARKcommand{\uInvEuPermShk}{{\PowMean_{1-\CRRA}[\permShk]}} % Formerly {\uInvEpShkuInv}

\ARKcommand{\RfreeEff}{\mathring{\Rfree}} % Blanchard-adjusted return R/\LivPrb: the survival ring (owner ruling 2026-10-22); R-bar is \RBoro

\ARKcommand{\PopnGroFac}{\varXi}
\ARKcommand{\PopnGroRte}{\ell\varXi}   % the log of the factor, ell-Xi (\logOp), explained where a document first introduces it
                                         % (owner ruling 2026-11-17); was n (2026-11-02), \ln\PopnGroFac, and before that xi
\ARKcommand{\PopnLvl}{\NLvl}   % population, a level: bold italic N (owner ruling 2026-11-15: a quantity is italic; was \pmb{\mathrm{N}})
  
\ARKcommand{\LivPrb}{\Alive}
% \livPrb (was \ell) retired (owner ruling 2026-10-22): used by no paper; \ell is \labor and survival is \LivPrb.

\ARKcommand{\pNotZero}{(1-\pZero)}

\ARKcommand{\CARA}{\upsilon}   % owner ruling 2026-11-03; was the word cara (2026-10-22). \alpha is the capital share (\kapShare)
\ARKcommand{\CRRA}{\varrho}   % not plain \rho, which papers keep for persistence and correlation (owner ruling 2026-10-22)
\ARKcommand{\MPC}{\kappa}

% --- Search-and-matching block -------------------------------------------------
% Ruling 2026-08-30. Two conventions, both from the owner:
%  (1) WORDS for the SAM model's own quantities -- an upright multi-letter name, as the
%      sequence-space literature this block descends from already does. Unlimited namespace,
%      self-documenting, and it ends the bidding for scarce Greek letters in the one block
%      where they ran out.
%  (2) A SAM parameter that wants a Greek letter ALREADY IN USE takes a TILDE. Read the tilde
%      as "a variant of the base symbol" -- the same reading that covers \qtilde (the trial
%      variant of q), so the decoration grammar stays one-meaning-per-mark.
\ARKcommand{\vacCost}{\mathrm{cst}}      % vacancy posting cost. NOT \kappa, which is the MPC.
\ARKcommand{\sepRte}{\mathrm{sep}}       % job separation rate. Convention (1): a word. It wanted
                                        % \omega only because one paper happened to use it, and
                                        % \omega is \weight above -- so there is no Greek letter it
                                        % has a claim on, and convention (2) does not apply.
\ARKcommand{\ADElas}{\varOmega}             % consumption elasticity of the aggregate-demand effect.
                                        % NOT \kappa (the MPC) and NOT \varkappa (too close to it).
                                        % A CAPITAL: this governs an economy-wide externality, not an
                                        % individual's behavior, so upper case follows the
                                        % aggregate/individual convention rather than fighting it.
\ARKcommand{\matchEff}{\mathrm{eff}}     % matching-function efficiency. Was \chi.
\ARKcommand{\matchElas}{\varpi}          % matching-function elasticity. A single letter, unlike its
                                        % four siblings, BECAUSE IT IS AN EXPONENT: e^{\varpi}, tgt^{1-\varpi}.
                                        % Was \alpha (NARK's \kapShare), then z (2026-08-30), which
                                        % passes to \leisure (owner ruling 2026-11-03). Mind omega
                                        % (\weight), which varpi resembles.
\ARKcommand{\vacFillPrb}{\mathrm{fill}}  % probability a VACANCY is filled. Was \phi, which is
                                        % NARK's \prstShkInd / \eprem -- and which the paper
                                        % additionally subscripts for the wage, Taylor and fiscal
                                        % rules, so the bare letter was the most overloaded in it.
\ARKcommand{\jobFindPrb}{\mathrm{find}}  % probability a SEARCHER finds a job. Was \eta, which the
                                        % registry claims as \etaL/\etaR. Named apart from
                                        % \vacFillPrb deliberately: the two differ only as
                                        % tgt^{1-\varpi} vs tgt^{-\varpi} and were easy to transpose.
\ARKcommand{\tightness}{\mathrm{tgt}}    % labor-market tightness, vacancies per searcher. Was
                                        % \Theta, which is NARK's \TranShkAgg / \TranShkEmp.
