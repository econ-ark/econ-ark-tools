% variables:
%% principles:
%% - Levels (Lvl) are boldface italic
%% - Normalized (Nrm) are plain
%% - Aggregate variables are marked by Agg and are upper case
%% - Individual variables are marked by Ind and are lower case
%% - The combination of Ind and Agg is marked by All
%% - If the problem has only one shock, the Ind and Agg can be omitted

% Note: Level and normalized variables for all letters are defined explicitly above
% Only special cases and exceptions need manual definition below

%% Individual-level (idosyncratic) variables
\ARKcommand{\permShkInd}{\psi}     % (purely) permanent
\ARKcommand{\permShk}{\permShkInd} % unspecified (but only one) shock
\ARKcommand{\PermShk}{\PermShkAgg} % unspecified (but only one) shock
\ARKcommand{\tranShkInd}{\xi}      % (purely) transitory
\ARKcommand{\permShkIndMin}{\Min{\permShkInd}}
\ARKcommand{\permShkIndMax}{\Max{\permShkInd}}
\ARKcommand{\prstShkAgg}{\Phi}     % persistent not permanent
% \prstShkInd, \prstShk and their Min/Max were \phi, which is the log equity premium (\eprem);
% used by no paper, they are retired (owner ruling 2026-10-22). A paper that needs a persistent shock proposes a symbol.
\ARKcommand{\tranShkMin}{\Min{\xi}}
\ARKcommand{\tranShkMax}{\Max{\xi}}

%% Transitory shock for employed individuals
\ARKcommand{\tranShkEmp}{\theta}     % ind
\ARKcommand{\TranShkEmp}{\TranShkAgg}  % alias: Theta is the aggregate of theta; \TranShkAgg is canonical (owner ruling 2026-10-22)
\ARKcommand{\tranShkEmpMin}{\Min{\tranShkEmp}}    
\ARKcommand{\tranShkEmpMax}{\Max{\tranShkEmp}}    
\ARKcommand{\IncUnemp}{\xi_{\mathrm{U}}}  % Income in unemployment: the transitory shock's value in the unemployment event
%  (owner, 2026-10-21; was \mu, which the notation registry gives to log excess resources, \logmNrmEx)

%% Agg variables (also affect individuals)
\ARKcommand{\TranShkAgg}{\Theta}   % the aggregate transitory shock, aggregate of \tranShkEmp (xi has no aggregate)
\ARKcommand{\PermShkAgg}{\Psi}  % 

%% Shock std and var
\ARKcommand{\std}{\sigma}
\ARKcommand{\tranShkIndStd}{\std_{\tranShkInd}}     % 
\ARKcommand{\tranShkIndVar}{\std^{2}_{\tranShkInd}} % 
\ARKcommand{\TranShkAggStd}{\std_{\TranShkAgg}}     %
\ARKcommand{\TranShkAggVar}{\std^{2}_{\TranShkAgg}} %

%% Combo variables (combining Ind and Agg)
% Principle: "All" (Ind+Agg) uses \pmb for all such macros. \pmb is supported by MathJax and KaTeX.
\ARKcommand{\PermShkAll}{\pmb{\Psi}}
\ARKcommand{\PermShkAllStd}{\std_{\PermShkAll}}
\ARKcommand{\PermShkAllVar}{\std^{2}_{\PermShkAll}}

