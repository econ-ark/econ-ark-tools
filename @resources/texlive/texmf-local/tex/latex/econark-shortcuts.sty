% Survival: an unaccented beta or thorn excludes the survival probability; the RING includes it (owner ruling 2026-10-22):
% \mathring{\beta} = \beta\LivPrb, \mathring{\APFac} = (\Rfree\mathring{\beta})^{1/\CRRA}. The ring variants take HARK's suffix
% Eff, as in its DiscFacEff = DiscFac*LivPrb and in \RfreeEff; "Liv" is kept for HARK's GPFacLiv (owner, 2026-10-22).
% (\DiscFacLiv was \Min{\DiscFacRaw}, an underline, which also means a lower bound.)
\ARKcommand{\DiscFacEff}{\mathring{\DiscFacRaw}}
\ARKcommand{\DiscFacLiv}{\DiscFacEff}   % alias: the v5 name, which the BST paper writes
\ARKcommand{\DiscRte}{\nu} % vartheta is too easily confused with theta
\ARKcommand{\discRte}{\nu} % 

% The thorn glyphs, both plain. \APFac makes the factor bold, once: \textbf, a real bold face, as
% in the notation registry (owner, 2026-10-21: "a single \textbf not double"; this was
% \text{\pmb{\Thorn}} with a \Thorn that was itself \pmb, so the thorn was bolded twice).
% \thorn is the rates' small thorn. The glyphs are taken from T1 whatever the document's encoding
% (in OT1 \TH does not exist); the generated KaTeX map writes them as Þ and þ.
\ARKcommand{\Thorn}{\text{\fontencoding{T1}\selectfont\TH}}
\ARKcommand{\thorn}{\text{\fontencoding{T1}\selectfont\th}}
\ARKcommand{\APFac}{\textbf{\Thorn}} % Former \Pat
\ARKcommand{\APFacDefn}{\hyperlink{APFacDefn}{\textrm{APF}}}

% The patience factors are WRITTEN with a subscript, as the registry writes them: Þ_𝒢 and Þ_R,
% not the ratios Þ/𝒢 and Þ/R that define them (ruling 2026-10-21, to bring econark-shortcuts
% and the notation registry to one form).
\ARKcommand{\GPFac}{\GPFacRaw}
\ARKcommand{\GPFacRaw}{\APFac_{\PermGroFac}}
\ARKcommand{\GPFacMod}{\GPFacRaw\EPermShkInv}  % BST's product form (owner ruling 2026-10-22) (was \APFac_{\PermGroFacAdj})
\ARKcommand{\RPFac}{\APFac_{\Rfree}}
% Survival-inclusive (ring) patience factors, HARK's APFac, RPFac and GPFacRaw, which all include LivPrb. The
% unaccented \APFac, \RPFac, \GPFacRaw above exclude survival, so HARK's same-named variables are the Eff forms.
\ARKcommand{\APFacEff}{\mathring{\APFac}}            % (\Rfree \DiscFacEff)^{1/\CRRA}
\ARKcommand{\RPFacEff}{\APFacEff_{\Rfree}}
\ARKcommand{\GPFacEff}{\APFacEff_{\PermGroFac}}
\ARKcommand{\GPFacLiv}{\LivPrb\GPFacEff}     % mortality-adjusted, HARK's GPFacLiv: the GIC-Liv is \GPFacLiv < 1

\ARKcommand{\RPRte}{\text{\thorn}_{\rfree}}
\ARKcommand{\GPRte}{\text{\thorn}_{\PermGroRte}}
\ARKcommand{\APRte}{\text{\thorn}}

\ARKcommand{\EPermShkInv}{\Ex[\permShk^{-1}]}  % Formerly EpShkInv
\ARKcommand{\InvEPermShkInv}{{(\EPermShkInv)}^{-1}} % written out (owner ruling 2026-10-22): \underline{\psi} is the minimum, \permShkIndMin
\ARKcommand{\uInvEuPermShk}{\Min{\Min{\permShk}}} % Formerly {\uInvEpShkuInv}

\ARKcommand{\RfreeEff}{\mathring{\Rfree}} % Blanchard-adjusted return R/\LivPrb: the survival ring (owner ruling 2026-10-22); R-bar is \RBoro

\ARKcommand{\PopnGroFac}{\Xi}
\ARKcommand{\PopnGroRte}{\ln\PopnGroFac}   % no letter of its own (owner ruling 2026-10-22); xi is the transitory shock
\ARKcommand{\PopnLvl}{\pmb{\mathrm{N}}}
  
\ARKcommand{\LivPrb}{\Alive}
% \livPrb (was \ell) retired (owner ruling 2026-10-22): used by no paper; \ell is \labor and survival is \LivPrb.

\ARKcommand{\pNotZero}{(1-\pZero)}

\ARKcommand{\CARA}{\mathrm{cara}}   % a word (owner ruling 2026-10-22); \alpha is the capital share (\kapShare)
\ARKcommand{\CRRA}{\varrho}   % not plain \rho, which papers keep for persistence and correlation (owner ruling 2026-10-22)
\ARKcommand{\MPC}{\kappa}

% --- Search-and-matching block -------------------------------------------------
% Ruling 2026-08-30. Two conventions, both from the owner:
%  (1) WORDS for the SAM model's own quantities -- an upright multi-letter name, as the
%      sequence-space literature this block descends from already does. Unlimited namespace,
%      self-documenting, and it ends the bidding for scarce Greek letters in the one block
%      where they ran out.
%  (2) A SAM parameter that wants a Greek letter ALREADY IN USE takes a TILDE. Read the tilde
%      as "a variant of the base symbol" -- the same reading that covers \qtilde (the trial
%      variant of q), so the decoration grammar stays one-meaning-per-mark.
\ARKcommand{\vacCost}{\mathrm{cst}}      % vacancy posting cost. NOT \kappa, which is the MPC.
\ARKcommand{\sepRte}{\mathrm{sep}}       % job separation rate. Convention (1): a word. It wanted
                                        % \omega only because one paper happened to use it, and
                                        % \omega is \weight above -- so there is no Greek letter it
                                        % has a claim on, and convention (2) does not apply.
\ARKcommand{\ADElas}{\Omega}             % consumption elasticity of the aggregate-demand effect.
                                        % NOT \kappa (the MPC) and NOT \varkappa (too close to it).
                                        % A CAPITAL: this governs an economy-wide externality, not an
                                        % individual's behavior, so upper case follows the
                                        % aggregate/individual convention rather than fighting it.
\ARKcommand{\matchEff}{\mathrm{eff}}     % matching-function efficiency. Was \chi.
\ARKcommand{\matchElas}{z}               % matching-function elasticity. A single letter, unlike its
                                        % four siblings, BECAUSE IT IS AN EXPONENT: e^{z}, tgt^{1-z}.
                                        % Was \alpha (NARK's \kapShare and \CARA). z is the only
                                        % lowercase Roman left -- n reads as individual employment
                                        % beside N, and x is \psav in the registry.
\ARKcommand{\vacFillPrb}{\mathrm{fill}}  % probability a VACANCY is filled. Was \phi, which is
                                        % NARK's \prstShkInd / \eprem -- and which the paper
                                        % additionally subscripts for the wage, Taylor and fiscal
                                        % rules, so the bare letter was the most overloaded in it.
\ARKcommand{\jobFindPrb}{\mathrm{find}}  % probability a SEARCHER finds a job. Was \eta, which the
                                        % registry claims as \etaL/\etaR. Named apart from
                                        % \vacFillPrb deliberately: the two differ only as
                                        % tgt^{1-z} vs tgt^{-z} and were easy to transpose.
\ARKcommand{\tightness}{\mathrm{tgt}}    % labor-market tightness, vacancies per searcher. Was
                                        % \Theta, which is NARK's \TranShkAgg / \TranShkEmp.
\ARKcommand{\MPCFunc}{\pmb{\kappa}}
