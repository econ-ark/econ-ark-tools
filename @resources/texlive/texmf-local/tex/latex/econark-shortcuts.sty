\ARKcommand{\permLvlInd}{\boldsymbol{\mathit{p}}}      % 
\ARKcommand{\permLvl}{\permLvlInd}      % 
\ARKcommand{\PermLvl}{\PermLvlAgg}      % 
\ARKcommand{\PermLvlAll}{\pmb{P}}

