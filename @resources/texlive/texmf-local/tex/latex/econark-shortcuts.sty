% econark-shortcuts.sty: Econ-ARK's shared LaTeX notation macros (hand-edited; with
% @resources/notation/notation.yml, the single source of notation for the papers).
% Explicit definitions only (no factory/\@for loops); Lvl/Nrm/Func for a-z and A-Z are inline.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{econark-shortcuts}[2026/10/22 v6.0.0 Econ-ARK shared notation]
% What the macros below need (2026-10-22). eucal is loaded only if no package has defined
% \mathscr already, so a class that loads it with its own options is not disturbed.
\RequirePackage{amsmath,amssymb,cancel,graphicx}
\@ifundefined{mathscr}{\RequirePackage[mathscr]{eucal}}{}
%
% ARK command definition utility - ensures our notation takes precedence
% Usage: \ARKcommand{\commandname}{definition}
% Makes it easy to find all ARK command definitions with global search
% Define \ARKcommand for backward compatibility and simple commands
\newcommand{\ARKcommand}[2]{%
  \providecommand{#1}{}%
  \renewcommand{#1}{#2}%
}

% 20251004: econark-shortcuts.sty had no standard definition of kapShare
% poached this one from handoutShortcuts.sty

\ARKcommand{\kapShare}{\alpha}

% Enhanced \ARKcommand for parameterized commands - much simpler approach!
% Usage: \ARKcommandParam{command}{num_params}{definition}
% Example: \ARKcommandParam{\cncl}{1}{{\cancel{#1}}}
\makeatletter
\newcommand{\ARKcommandParam}[3]{%
  \@ifundefined{\expandafter\@gobble\string#1}{}{\let#1\undefined}%  % undefine if it exists
  \newcommand{#1}[#2]{#3}%  % then define with parameters
}
\makeatother

