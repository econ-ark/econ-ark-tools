% -*- mode: LaTeX; TeX-PDF-mode: t; -*-
% Leaves out of the PDF what changes from one build to the next with the same input (dates,
% the file ID, file names and paths), so that rebuilding unchanged sources gives the same bytes
% and a git diff of the PDF shows only real changes.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pdfsuppressruntime}[2026/11/27 no dates, file ID or paths in the PDF]
\RequirePackage{iftex}
\ifPDFTeX % pdfLaTeX, and latex making DVI for tex4ht, where these settings do nothing
  \pdfinfoomitdate=1      % no CreationDate or ModDate
  \pdftrailerid{}         % no file ID
  \pdfsuppressptexinfo=-1 % no PTEX.* keys: banner, included files' names, page numbers, info dicts
\else\ifLuaTeX % LuaLaTeX: the same, through \pdfvariable (LuaTeX has no \pdfinfoomitdate)
  % 623 = 1+2+4+8 (the PTEX.* keys) + 32+64 (both dates) + 512 (the file ID). Creator (16),
  % Producer (128) and Trapped (256) stay, since they don't change between builds.
  \pdfvariable suppressoptionalinfo 623
\else\ifXeTeX
  % xdvipdfmx can't be told to leave the date out, and it names font subsets at random, so a
  % XeLaTeX PDF is reproducible only with SOURCE_DATE_EPOCH set in the environment, which fixes
  % both. This fixes the file ID, and drops the build time from the default Creator
  % ("XeTeX output 2026.11.27:2155"); a Creator set later, such as hyperref's, replaces it.
  \AtBeginDvi{%
    \special{pdf:trailerid [<00112233445566778899aabbccddeeff><00112233445566778899aabbccddeeff>]}%
    \special{pdf:docinfo << /Creator (XeTeX) >>}}
\fi\fi\fi
