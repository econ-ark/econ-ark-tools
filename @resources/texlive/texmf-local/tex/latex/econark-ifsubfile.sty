\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{econark-ifsubfile}[2026/11/25 Define ifsubfile condition]


\newif\ifsubfile

% A subfile compiled on its own uses the subfiles class, which then reads the main file's
% preamble, so this package is loaded in both cases; the main document never loads that class.
% (Until 2026-11-25 this tested whether \@mainfile was undefined. Nothing defines it, so every
% build, the main document's included, was taken for a subfile build.)
\@ifclassloaded{subfiles}{\subfiletrue}{\subfilefalse}

\providecommand{\onlyinsubfile}{}
\providecommand{\notinsubfile}{}
\providecommand{\compilingassubfile}{}
\providecommand{\compilingasstandalone}{}

\ifsubfile
  % Compiling a subfile standalone (not included from main)
  \renewcommand{\onlyinsubfile}[1]{#1}
  \renewcommand{\notinsubfile}[1]{}
  \renewcommand{\compilingassubfile}[1]{#1}
  \renewcommand{\compilingasstandalone}[1]{#1}
\else
  % Compiling the main document
  \renewcommand{\onlyinsubfile}[1]{}
  \renewcommand{\notinsubfile}[1]{#1}
  \renewcommand{\compilingassubfile}[1]{}
  \renewcommand{\compilingasstandalone}[1]{}
\fi

\endinput
